# Exportar variáveis no ambiente; este arquivo não contém credenciais.
OPENROUTER_API_KEY=
LLM_EXTRACTOR_MODEL=openai/gpt-4.1-mini
LLM_CONVERSATION_MODEL=openai/gpt-4.1
LLM_MEDIA_MODEL=google/gemini-2.5-flash
# Teto por chamada no p99.9, com um retry (D-038)
LLM_TIMEOUT_SECONDS=7.0
LLM_BUDGET_SECONDS=7.0
LLM_CONVERSATION_TOKEN_LIMIT=16000
LLM_EVAL_MODE=replay
# Caminho local do corpus, que permanece fora do git:
AUTOSEGURO_DATASET=../namastex-fde-challenge/dataset/conversations.parquet
